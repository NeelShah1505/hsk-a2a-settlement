# HSP Agentic Payment MCP endpoint (Streamable HTTP). App Key/Secret are managed server-side.
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/

# Your hackathon team reporting name. MUST be identical in create_order and query_payment.
MERCHANT_NAME=your-team-name

# Recipient (receiving agent) EVM address — 42 chars, 0x...
PAY_TO=0x0000000000000000000000000000000000000000

# ---- Signer selection: "okx" (wallet skill) or "burner" (local private key) ----
SIGNER=burner

# Burner signer only. Testnet/QA key. NEVER a key holding real funds.
BURNER_PRIVATE_KEY=0x

# Safety cap as a HUMAN token amount (e.g. 5 = 5 tokens). Converted to raw units
# with the live token decimals at sign time. Agent refuses to sign above this.
MAX_TOKEN_AMOUNT=5

# Payment amount to request, in USD (cart_mandate currency is always USD).
AMOUNT_USD=1

# Optional: pin the network/token when get_chain_config returns several options.
# HSP_NETWORK=
# HSP_TOKEN_SYMBOL=
